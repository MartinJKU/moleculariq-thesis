#!/bin/bash
#SBATCH --job-name=miq_analysis
#SBATCH --account=EUHPC_D27_069
#SBATCH --partition=lrd_all_serial
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=30G
#SBATCH --time=04:00:00
